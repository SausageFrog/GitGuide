---
// src/components/GitHero.astro
// Hero Astro component
---

<section class="relative w-full min-h-screen overflow-hidden bg-[#f8fafc] flex items-center">
  <svg
    viewBox="0 0 1400 900"
    class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!--Isometric gric 30 -->
      <pattern id="iso-grid" width="120" height="120" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
        <path d="M 120 0 L 0 0 0 120" fill="none" stroke="#e2e8f0" stroke-width="1.5" />
        <path d="M 0 0 L 120 120" fill="none" stroke="#f1f5f9" stroke-width="1" />
      </pattern>

      <!-- Coding Animation - Disabled for now -->
     <!--  
      <g id="deco-git-card" opacity="0.38">
       
        <g transform="rotate(-30)">
          <rect x="0" y="0" width="26" height="26" rx="5" fill="#64748b" />
          <circle cx="9" cy="8" r="2.2" fill="#f8fafc" />
          <circle cx="9" cy="18" r="2.2" fill="#f8fafc" />
          <circle cx="17" cy="12" r="2.2" fill="#f8fafc" />
          <path d="M 9 10 L 9 16 M 9 13 C 13 13 13 12 15 12" stroke="#f8fafc" stroke-width="1.8" fill="none" />
     
          <line x1="36" y1="4" x2="62" y2="4" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
          <line x1="70" y1="4" x2="85" y2="4" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
          <line x1="36" y1="12" x2="95" y2="12" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
          <line x1="36" y1="20" x2="52" y2="20" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
          <line x1="60" y1="20" x2="88" y2="20" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
          <line x1="36" y1="28" x2="74" y2="28" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
        </g>
      </g> -->

      <!-- External Gradient -->
      <radialGradient id="fade-mask" cx="60%" cy="50%" r="55%">
        <stop offset="65%" stop-color="white" stop-opacity="1" />
        <stop offset="100%" stop-color="white" stop-opacity="0" />
      </radialGradient>
      <mask id="edge-fade">
        <rect width="1400" height="900" fill="url(#fade-mask)" />
      </mask>
    </defs>

    <!-- Grill Background -->
    <rect width="100%" height="100%" fill="url(#iso-grid)" />

    <g mask="url(#edge-fade)">
      <!-- decorative cards, disabled for now, -->
     <!--  <use href="#deco-git-card" x="420" y="540" class="deco-anim deco-1" />
      <use href="#deco-git-card" x="680" y="680" class="deco-anim deco-2" />
      <use href="#deco-git-card" x="980" y="190" class="deco-anim deco-3" /> -->
      
      <!--MAIN-->
      <path
        pathLength="1"
        d="M 250,750 L 1350,115"
        class="branch-line anim-main"
      />

      <!-- DEV -->
      <path
        pathLength="1"
        d="M 450,634.5 C 495,608 515,670 570,638 L 1170,291.5"
        class="branch-line anim-dev"
      />

      <!-- DEV TO MAIN MERGE PATH -->
      <path
        pathLength="1"
        d="M 990,395.5 C 1035,369 1015,308 1050,288"
        class="branch-line anim-merge"
      />

      <!-- FEATURE 1 -->
      <path
        pathLength="1"
        d="M 650,519 C 690,495 660,440 715,408 L 835,339"
        class="branch-line anim-feat-1"
      />

      <!-- FEATURE 2-->
      <path
        pathLength="1"
        d="M 770,522.5 C 815,496 835,555 890,523 L 995,462"
        class="branch-line anim-feat-2"
      />

      <!-- FEATURE 3 -->
      <path
        pathLength="1"
        d="M 770,522.5 C 825,555 910,655 985,612 L 1115,537"
        class="branch-line anim-feat-3"
      />

      <circle cx="450" cy="634.5" r="10" class="commit-dot dot-dev-start" />
      <circle cx="650" cy="519"   r="10" class="commit-dot dot-feat1-start" />
      <circle cx="835" cy="339"   r="10" class="commit-dot dot-feat1-end" />
      <circle cx="770" cy="522.5" r="10" class="commit-dot dot-feat23-start" />
      <circle cx="995" cy="462"   r="10" class="commit-dot dot-feat2-end" />
      <circle cx="1115" cy="537"  r="10" class="commit-dot dot-feat3-end" />
      <circle cx="1050" cy="288"  r="10" class="commit-dot dot-main-merge" />
      <circle cx="1170" cy="291.5" r="10" class="commit-dot dot-dev-end" />

      <g transform="translate(1155, 227) rotate(-30)" class="label-group lbl-main">
        <rect x="-8" y="-22" width="76" height="30" rx="6" fill="#f8fafc" />
        <text x="0" y="0" class="branch-text">main</text>
      </g>

      <g transform="translate(1192, 286) rotate(-30)" class="label-group lbl-dev">
        <text x="0" y="0" class="branch-text">dev</text>
      </g>

      <g transform="translate(855, 334) rotate(-30)" class="label-group lbl-feat1">
        <text x="0" y="0" class="branch-text">feature</text>
      </g>

      <g transform="translate(1015, 457) rotate(-30)" class="label-group lbl-feat2">
        <text x="0" y="0" class="branch-text">feature</text>
      </g>

      <g transform="translate(1135, 532) rotate(-30)" class="label-group lbl-feat3">
        <text x="0" y="0" class="branch-text">feature</text>
      </g>
    </g>
  </svg>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-2xl px-8 md:px-20 pb-24">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-slate-900 tracking-tight leading-[1.12]">
      Git & Github
    </h1>

    <p class="mt-6 text-lg text-slate-600 max-w-lg leading-relaxed">
      Una guia practica para el desarrollo en equipo.
    </p>
  </div>
</section>

<style>
  :root {
    --cycle: 9s;
  }

  .branch-line {
    fill: none;
    stroke: #1e293b;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1.05;
    stroke-dashoffset: 1.05;
  }

  .commit-dot {
    fill: #f8fafc;
    stroke: #1e293b;
    stroke-width: 5.5;
    transform: scale(0);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .branch-text {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 26px;
    font-weight: 500;
    fill: #1e293b;
    letter-spacing: -0.02em;
  }

  .label-group {
    opacity: 0;
  }

  .anim-main   { animation: k-main   var(--cycle) linear infinite; }
  .anim-dev    { animation: k-dev    var(--cycle) ease-out infinite; }
  .anim-feat-1 { animation: k-feat1  var(--cycle) ease-out infinite; }
  .anim-feat-2 { animation: k-feat2  var(--cycle) ease-out infinite; }
  .anim-feat-3 { animation: k-feat3  var(--cycle) ease-out infinite; }
  .anim-merge  { animation: k-merge  var(--cycle) ease-in-out infinite; }

  @keyframes k-main {
    0%        { stroke-dashoffset: 1.05; opacity: 0; }
    1%        { stroke-dashoffset: 1.05; opacity: 1; }
    50%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  @keyframes k-dev {
    0%, 8.9%  { stroke-dashoffset: 1.05; opacity: 0; }
    9%        { stroke-dashoffset: 1.05; opacity: 1; }
    48%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  @keyframes k-feat1 {
    0%, 17.9% { stroke-dashoffset: 1.05; opacity: 0; }
    18%       { stroke-dashoffset: 1.05; opacity: 1; }
    34%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  @keyframes k-feat2 {
    0%, 23.9% { stroke-dashoffset: 1.05; opacity: 0; }
    24%       { stroke-dashoffset: 1.05; opacity: 1; }
    40%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  @keyframes k-feat3 {
    0%, 23.9% { stroke-dashoffset: 1.05; opacity: 0; }
    24%       { stroke-dashoffset: 1.05; opacity: 1; }
    44%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  @keyframes k-merge {
    0%, 34.9% { stroke-dashoffset: 1.05; opacity: 0; }
    35%       { stroke-dashoffset: 1.05; opacity: 1; }
    45%, 88%  { stroke-dashoffset: 0;    opacity: 1; }
    96%, 100% { stroke-dashoffset: 0;    opacity: 0; }
  }

  .dot-dev-start    { animation: pop-dev-start    var(--cycle) ease-out infinite; }
  .dot-feat1-start  { animation: pop-feat1-start  var(--cycle) ease-out infinite; }
  .dot-feat1-end    { animation: pop-feat1-end    var(--cycle) ease-out infinite; }
  .dot-feat23-start { animation: pop-feat23-start var(--cycle) ease-out infinite; }
  .dot-feat2-end    { animation: pop-feat2-end    var(--cycle) ease-out infinite; }
  .dot-feat3-end    { animation: pop-feat3-end    var(--cycle) ease-out infinite; }
  .dot-main-merge   { animation: pop-main-merge   var(--cycle) ease-out infinite; }
  .dot-dev-end      { animation: pop-dev-end      var(--cycle) ease-out infinite; }

  @keyframes pop-dev-start {
    0%, 8%    { transform: scale(0);    opacity: 0; }
    8.5%      { transform: scale(0);    opacity: 1; }
    11%       { transform: scale(1.25); opacity: 1; }
    13%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-feat1-start {
    0%, 17%   { transform: scale(0);    opacity: 0; }
    17.5%     { transform: scale(0);    opacity: 1; }
    20%       { transform: scale(1.25); opacity: 1; }
    22%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-feat23-start {
    0%, 23%   { transform: scale(0);    opacity: 0; }
    23.5%     { transform: scale(0);    opacity: 1; }
    26%       { transform: scale(1.25); opacity: 1; }
    28%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-feat1-end {
    0%, 33%   { transform: scale(0);    opacity: 0; }
    33.5%     { transform: scale(0);    opacity: 1; }
    36%       { transform: scale(1.25); opacity: 1; }
    38%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-feat2-end {
    0%, 39%   { transform: scale(0);    opacity: 0; }
    39.5%     { transform: scale(0);    opacity: 1; }
    42%       { transform: scale(1.25); opacity: 1; }
    44%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-feat3-end {
    0%, 43%   { transform: scale(0);    opacity: 0; }
    43.5%     { transform: scale(0);    opacity: 1; }
    46%       { transform: scale(1.25); opacity: 1; }
    48%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-main-merge {
    0%, 43%   { transform: scale(0);    opacity: 0; }
    43.5%     { transform: scale(0);    opacity: 1; }
    46%       { transform: scale(1.25); opacity: 1; }
    48%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }
  @keyframes pop-dev-end {
    0%, 47%   { transform: scale(0);    opacity: 0; }
    47.5%     { transform: scale(0);    opacity: 1; }
    50%       { transform: scale(1.25); opacity: 1; }
    52%, 88%  { transform: scale(1);    opacity: 1; }
    96%, 100% { transform: scale(1);    opacity: 0; }
  }

  .lbl-feat1 { animation: fade-lbl-1 var(--cycle) ease-out infinite; }
  .lbl-feat2 { animation: fade-lbl-2 var(--cycle) ease-out infinite; }
  .lbl-feat3 { animation: fade-lbl-3 var(--cycle) ease-out infinite; }
  .lbl-main  { animation: fade-lbl-m var(--cycle) ease-out infinite; }
  .lbl-dev   { animation: fade-lbl-d var(--cycle) ease-out infinite; }

  @keyframes fade-lbl-1 {
    0%, 34%  { opacity: 0; }
    39%, 88% { opacity: 1; }
    96%, 100%{ opacity: 0; }
  }
  @keyframes fade-lbl-2 {
    0%, 40%  { opacity: 0; }
    45%, 88% { opacity: 1; }
    96%, 100%{ opacity: 0; }
  }
  @keyframes fade-lbl-3 {
    0%, 44%  { opacity: 0; }
    49%, 88% { opacity: 1; }
    96%, 100%{ opacity: 0; }
  }
  @keyframes fade-lbl-m {
    0%, 45%  { opacity: 0; }
    50%, 88% { opacity: 1; }
    96%, 100%{ opacity: 0; }
  }
  @keyframes fade-lbl-d {
    0%, 48%  { opacity: 0; }
    53%, 88% { opacity: 1; }
    96%, 100%{ opacity: 0; }
  }

  .deco-anim { animation: fade-deco var(--cycle) ease-in-out infinite; }
  @keyframes fade-deco {
    0%, 10%  { opacity: 0; }
    30%, 88% { opacity: 0.38; }
    96%, 100%{ opacity: 0; }
  }
</style>